APP_NAME=Laravel
APP_ENV=local
# Must be identical in both apps, otherwise signed links (account deletion cancel) fail.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Portal URL used by company rejection links.
JOB_SEEKER_PORTAL_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Shared with the Job Seeker Portal (same database). This worker must process only the "default" queue.
# The "ai" queue is processed by the Portal worker. AI_* settings belong to the Portal, not here.

# Must be identical in job-management and job-seeker-app.
CACHE_STORE=database
CACHE_PREFIX=shagalni-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CLOUDINARY_URL=

VITE_APP_NAME="${APP_NAME}"
